VITE_WS_URL=https://psb-back.onrender.com

# Base URL of the psb-app-web Next.js app, which hosts the analyst API
# (/api/analyst/*) behind Neon Postgres. Point this at wherever that app runs —
# http://localhost:3000 for `next dev`, or the deployed Vercel URL.
VITE_ANALYST_API_URL=http://localhost:3000

# Must match ANALYST_API_KEY in psb-app-web's .env.
#
# This value ships in the built client bundle — it is not a secret, and the
# analyst API is only as protected as the obscurity of this string. Accepted
# for the demo, documented in DEMO-IMPLEMENTATION-PLAN.md §2.4.
VITE_ANALYST_API_KEY=2202710a5154c0b0e2ed5d457cb0c578523c94f666ed3546da9457d150052d36
